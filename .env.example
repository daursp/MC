# Скопируйте этот файл в .env и заполните своими значениями.
# После изменения .env перезапустите сервер.

# Токен бота от @BotFather, например: 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# ID канала или чата. Для публичного канала можно указать @username,
# для приватного — числовой ID вида -1001234567890.
TELEGRAM_CHAT_ID=

# Если Telegram API недоступен напрямую, укажите прокси в переменных окружения
# и запускайте сайт командой npm run start:proxy (см. README).
# HTTPS_PROXY=http://127.0.0.1:1080
